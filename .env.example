DB_HOST=localhost
DB_PORT=3306
DB_NAME=nextern_php
DB_USER=replace-with-your-database-user
DB_PASS_ENCRYPTED=v1:replace-with-an-aes-256-gcm-encrypted-value
DB_CHARSET=utf8mb4

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=notifications@example.com
SMTP_PASS_ENCRYPTED=v1:replace-with-an-aes-256-gcm-encrypted-value
SMTP_FROM=notifications@example.com
SMTP_FROM_NAME=Nextern

# Base64-encoded 32-byte AES-256 key. Do not commit the real value.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-now
SESSION_SECRET=replace-session-secret
ADMIN_EMAILS=owner@example.com
